{
  "name": "binsql",
  "version": "0.0.2",
  "description": "Allowlisted SQL parser and serializer for canonical PostgreSQL output",
  "author": "ricsam <oss@ricsam.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricsam/binsql.git"
  },
  "bugs": {
    "url": "https://github.com/ricsam/binsql/issues"
  },
  "homepage": "https://github.com/ricsam/binsql#readme",
  "keywords": [
    "sql",
    "postgres",
    "postgresql",
    "parser",
    "serializer",
    "ast",
    "allowlist",
    "canonical-sql",
    "sql-dialect",
    "bun"
  ],
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx --bun tsc --noEmit",
    "build:npm": "bun scripts/build.ts",
    "changeset": "bunx --bun changeset",
    "version-packages": "bunx --bun changeset version",
    "publish:npm": "bun run build:npm && bunx --bun changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "latest",
    "@types/bun": "latest",
    "libpg-query": "^17.7.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "chevrotain": "^12.0.0"
  }
}
